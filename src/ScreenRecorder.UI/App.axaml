<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="using:ScreenRecorder.UI.Localization"
             x:Class="ScreenRecorder.UI.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/app_icon.png" ToolTipText="OpenCam" Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding [TrayShowWindow], Source={x:Static localization:LanguageManager.Instance}}" Click="OnShowMainWindowClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{Binding [OpenFolder], Source={x:Static localization:LanguageManager.Instance}}" Click="OnOpenFolderClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{Binding [TrayExit], Source={x:Static localization:LanguageManager.Instance}}" Click="OnExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
