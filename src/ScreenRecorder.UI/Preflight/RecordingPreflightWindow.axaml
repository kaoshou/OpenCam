<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ScreenRecorder.UI.Preflight" x:Class="ScreenRecorder.UI.Preflight.RecordingPreflightWindow"
        x:DataType="local:RecordingPreflightViewModel" Width="740" Height="610" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" RequestedThemeVariant="Light" Icon="/Assets/app_icon.png">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,9"/></Style>
    <Style Selector="Button /template/ ContentPresenter"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="#F1F5F9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="#475569"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="#2563EB"/><Setter Property="Background" Value="#E2E8F0"/></Style>
    <Style Selector="Button.primary /template/ ContentPresenter"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#334155"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="20,16,20,12" Spacing="6">
      <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" Foreground="#0F172A"/>
      <TextBlock x:Name="Privacy" TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,0,20,12" Spacing="10">
        <Grid x:Name="AudioCards" ColumnDefinitions="*,12,*">
          <Border Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Spacing="7">
              <TextBlock x:Name="MicrophoneLabel" FontWeight="SemiBold"/>
              <ProgressBar x:Name="MicrophoneMeter" Maximum="1" Height="8"/>
              <Grid ColumnDefinitions="*,Auto">
                <Slider x:Name="MicrophoneVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"/>
                <TextBlock x:Name="MicrophoneVolumeValue" Grid.Column="1" MinWidth="45" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="MicrophoneStatus" FontSize="12" TextWrapping="Wrap"/>
              <Button x:Name="DisableMicrophone" Classes="quiet" Click="OnDisableMicrophone" FontSize="11"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Spacing="7">
              <TextBlock x:Name="SystemLabel" FontWeight="SemiBold"/>
              <ProgressBar x:Name="SystemMeter" Maximum="1" Height="8"/>
              <Grid ColumnDefinitions="*,Auto">
                <Slider x:Name="SystemVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"/>
                <TextBlock x:Name="SystemVolumeValue" Grid.Column="1" MinWidth="45" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="SystemStatus" FontSize="12" TextWrapping="Wrap"/>
              <Button x:Name="DisableSystem" Classes="quiet" Click="OnDisableSystem" FontSize="11"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="MixArea" Background="White" CornerRadius="10" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
          <StackPanel Spacing="7">
            <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="MixLabel" FontWeight="SemiBold"/><TextBlock x:Name="MixStatus" Grid.Column="1" FontSize="12"/></Grid>
            <ProgressBar x:Name="MixMeter" Maximum="1" Height="8"/>
            <TextBlock x:Name="VolumeHint" TextWrapping="Wrap" FontSize="12" Foreground="#64748B"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="VolumeNotice" TextWrapping="Wrap" FontSize="12" Foreground="#92400E" VerticalAlignment="Center"/>
              <Button x:Name="ResetVolumesButton" Grid.Column="1" Classes="quiet" Click="OnResetVolumes"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="StatusArea" Background="#F1F5F9" CornerRadius="10" Padding="14" MinHeight="110">
          <StackPanel Spacing="9">
            <TextBlock x:Name="StatusMessage" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusHint" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
            <ProgressBar x:Name="StatusActivity" IsIndeterminate="True" Height="4"/>
            <ProgressBar x:Name="TrialProgress" Maximum="5" Height="5" IsVisible="False"/>
            <TextBlock x:Name="ErrorLabel" Foreground="#B91C1C" TextWrapping="Wrap" IsVisible="False"/>
          </StackPanel>
        </Border>
        <Border x:Name="SilenceArea" Background="#FFFBEB" CornerRadius="8" Padding="12,9" IsVisible="{Binding ShowSilenceNotice}">
          <TextBlock x:Name="SilenceNotice" Foreground="#92400E" FontSize="12" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="White" Padding="20,12">
      <StackPanel Spacing="8">
        <WrapPanel x:Name="AudioActions" Orientation="Horizontal">
          <Button x:Name="TrialButton" Margin="0,0,6,4" IsEnabled="{Binding CanTrial}" Click="OnTrial"/>
          <Button x:Name="ReplayButton" Margin="0,0,6,4" IsEnabled="{Binding CanReplay}" Click="OnReplay"/>
          <Button x:Name="StopReplayButton" Margin="0,0,6,4" Click="OnStopReplay"/>
          <Button x:Name="RecheckButton" Margin="0,0,6,4" Click="OnRecheck"/>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Click="OnCancel"/>
          <Button x:Name="StartButton" Classes="primary" IsEnabled="{Binding CanStart}" Click="OnStart"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
