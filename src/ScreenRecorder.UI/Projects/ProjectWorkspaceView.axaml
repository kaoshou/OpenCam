<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:ScreenRecorder.UI.Projects" xmlns:core="using:ScreenRecorder.Core.Projects"
        xmlns:editor="using:ScreenRecorder.UI.Projects.Editor"
        x:Class="ScreenRecorder.UI.Projects.ProjectWorkspaceView" x:DataType="p:ProjectWorkspaceViewModel"
        Title="{Binding Strings[ProjectWorkspace]}" Icon="/Assets/app_icon.png"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640" Background="{DynamicResource ProjectCanvasBrush}"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <editor:ClipDensityLabelConverter x:Key="ClipDensityLabel"/>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ProjectCanvasBrush" Color="#F4F6F8"/>
          <SolidColorBrush x:Key="ProjectCardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ProjectRowBrush" Color="#F1F5F9"/>
          <SolidColorBrush x:Key="ProjectTextBrush" Color="#0F172A"/>
          <SolidColorBrush x:Key="ProjectMutedBrush" Color="#64748B"/>
          <SolidColorBrush x:Key="ProjectStrokeBrush" Color="#E2E8F0"/>
          <SolidColorBrush x:Key="ProjectAccentBrush" Color="#2563EB"/>
          <SolidColorBrush x:Key="ProjectErrorBrush" Color="#B42318"/>
          <SolidColorBrush x:Key="ProjectSelectedBrush" Color="#EDF2FF"/>
          <SolidColorBrush x:Key="ProjectSelectedStrokeBrush" Color="#879DC8"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ProjectCanvasBrush" Color="#202329"/>
          <SolidColorBrush x:Key="ProjectCardBrush" Color="#292D34"/>
          <SolidColorBrush x:Key="ProjectRowBrush" Color="#323842"/>
          <SolidColorBrush x:Key="ProjectTextBrush" Color="#F1F5F9"/>
          <SolidColorBrush x:Key="ProjectMutedBrush" Color="#A8B5C7"/>
          <SolidColorBrush x:Key="ProjectStrokeBrush" Color="#455060"/>
          <SolidColorBrush x:Key="ProjectAccentBrush" Color="#86B4FF"/>
          <SolidColorBrush x:Key="ProjectErrorBrush" Color="#FFAEA6"/>
          <SolidColorBrush x:Key="ProjectSelectedBrush" Color="#293C5B"/>
          <SolidColorBrush x:Key="ProjectSelectedStrokeBrush" Color="#86A6D7"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,6"/><Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource ProjectCardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ProjectTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ProjectStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource ProjectRowBrush}"/></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ProjectMutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ProjectStrokeBrush}"/>
    </Style>
    <Style Selector="Button.tool"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.previewControl">
      <Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="9,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ComboBox.previewControl">
      <Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.inspectorAction">
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="38"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource ProjectErrorBrush}"/></Style>
    <Style Selector="Button#ApplyPropertiesButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button#ApplyPropertiesButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D4ED8"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.rename:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ProjectSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ProjectAccentBrush}"/>
    </Style>
    <Style Selector="Button.rename:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ProjectSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ProjectAccentBrush}"/>
    </Style>
    <Style Selector="Button.rename:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource ProjectAccentBrush}"/>
    </Style>
    <Style Selector="Button#ExportButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button#ExportButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D4ED8"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button#ExportButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1E40AF"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button#ExportButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="TextBox"><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="5"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource ProjectRowBrush}"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource ProjectSelectedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ProjectSelectedStrokeBrush}"/></Style>
    <Style Selector="ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource ProjectAccentBrush}"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectTextBrush}"/></Style>
  </Window.Styles>
  <Grid x:Name="EditorRoot" RowDefinitions="64,Auto,*,6,240,28">
    <Border x:Name="EditorHeader" Background="{DynamicResource ProjectCardBrush}" BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="0,0,0,1" Padding="16,8">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,22,0">
        <Button x:Name="ReturnToRecordingButton" Classes="tool" Click="OnCaptureSettings"
                IsEnabled="{Binding CanReturnToRecording}" ToolTip.Tip="{Binding Strings[ProjectCaptureSettings]}"
                AutomationProperties.Name="{Binding Strings[ProjectCaptureSettings]}">
          <editor:EditorToolContent Icon="back"/>
        </Button>
        <Image Source="/Assets/app_icon.png" Width="28" Height="28"/>
        <TextBlock Text="OpenCam" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
          <TextBlock x:Name="ProjectNameLabel" Text="{Binding State.Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" ToolTip.Tip="{Binding State.Name}"/>
          <Button x:Name="RenameProjectButton" Grid.Column="1" Classes="rename" Click="OnRenameProject" IsEnabled="{Binding CanRecord}"
                  Width="32" Height="32" MinHeight="32" Padding="7" Margin="6,0,0,0" CornerRadius="7"
                  Background="{DynamicResource ProjectRowBrush}" BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="1"
                  ToolTip.Tip="{Binding Strings[ProjectRenameAction]}" AutomationProperties.Name="{Binding Strings[ProjectRenameAction]}">
            <editor:EditorToolContent Icon="rename"/>
          </Button>
        </Grid>
        <TextBlock Text="{Binding SaveStatus}" FontSize="12" Foreground="{DynamicResource ProjectMutedBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Content="{Binding Strings[ProjectSave]}" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button x:Name="BookmarksButton" Content="{Binding Strings[BookmarkTitle]}">
          <Button.Flyout><Flyout Opening="OnBookmarksOpening">
            <ScrollViewer Width="400" MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <editor:EditorToolContent Icon="bookmark" Text="{Binding Strings[BookmarkTitle]}"/>
                <Button Grid.Column="1" Command="{Binding RefreshBookmarksCommand}" ToolTip.Tip="{Binding Strings[ProjectRefresh]}">
                  <editor:EditorToolContent Icon="refresh" Text="{Binding Strings[ProjectRefresh]}"/>
                </Button>
              </Grid>
              <Border Background="{DynamicResource ProjectRowBrush}" CornerRadius="10" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding BookmarkPositionText}" FontSize="12" Foreground="{DynamicResource ProjectMutedBrush}"/>
                  <TextBox x:Name="NewBookmarkNameBox" Text="{Binding NewBookmarkName}" MaxLength="200"
                           Watermark="{Binding Strings[BookmarkNamePlaceholder]}" IsEnabled="{Binding CanAddEditorBookmark}"/>
                  <Button x:Name="AddEditorBookmarkButton" Command="{Binding AddEditorBookmarkCommand}" IsEnabled="{Binding CanAddEditorBookmark}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#2563EB" Foreground="White">
                    <editor:EditorToolContent Icon="bookmark" Text="{Binding Strings[BookmarkAddHere]}" Foreground="White"/>
                  </Button>
                </StackPanel>
              </Border>
              <Border IsVisible="{Binding !HasBookmarks}" Background="{DynamicResource ProjectRowBrush}" CornerRadius="8" Padding="16">
                <TextBlock Text="{Binding Strings[BookmarkEmpty]}" TextWrapping="Wrap" Foreground="{DynamicResource ProjectMutedBrush}" FontSize="12"/>
              </Border>
              <ListBox x:Name="BookmarksList" IsVisible="{Binding HasBookmarks}" MinHeight="60" MaxHeight="180" ItemsSource="{Binding Bookmarks}" SelectedItem="{Binding SelectedBookmark}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate x:DataType="core:ProjectBookmarkPosition">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,7">
                    <TextBlock Text="⚑" Foreground="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ProjectMutedBrush}"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Spacing="8" IsVisible="{Binding HasBookmarks}">
                <TextBlock Text="{Binding Strings[BookmarkSelectionHint]}" FontSize="11" Foreground="{DynamicResource ProjectMutedBrush}"/>
                <TextBox Text="{Binding BookmarkName}" MaxLength="200" IsEnabled="{Binding CanDeleteBookmark}"/>
                <Grid ColumnDefinitions="*,*">
                  <Button x:Name="RenameBookmarkButton" Content="{Binding Strings[BookmarkRename]}" Command="{Binding RenameBookmarkCommand}" IsEnabled="{Binding CanRenameBookmark}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0"/>
                  <Button x:Name="DeleteBookmarkButton" Grid.Column="1" Classes="danger" Content="{Binding Strings[BookmarkDelete]}" Command="{Binding DeleteBookmarkCommand}" IsEnabled="{Binding CanDeleteBookmark}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0"/>
                </Grid>
              </StackPanel>
              <TextBlock Text="{Binding Strings[BookmarkNotice]}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ProjectMutedBrush}"/>
              <TextBlock Text="{Binding BookmarkError}" TextWrapping="Wrap" Foreground="{DynamicResource ProjectErrorBrush}"/>
            </StackPanel>
            </ScrollViewer>
          </Flyout></Button.Flyout>
        </Button>
        <Button x:Name="SubtitlesButton" Click="OnManageSubtitles" IsEnabled="{Binding CanEditTimeline}">
          <editor:EditorToolContent Icon="subtitles" Text="{Binding Strings[SubtitleAttach]}"/>
        </Button>
        <Button x:Name="ExportButton" IsEnabled="{Binding CanExport}" Background="#2563EB" Foreground="White" AutomationProperties.Name="{Binding Strings[ProjectExportMenu]}">
          <Button.Flyout><MenuFlyout>
            <MenuItem Header="{Binding Strings[ProjectExportVideo]}" Click="OnExport"/>
            <MenuItem Header="{Binding Strings[ProjectExportWeb]}" Click="OnExportWebPlayer"/>
          </MenuFlyout></Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="7"><editor:EditorToolContent Icon="export" Text="{Binding Strings[ProjectExportMenu]}" Foreground="White"/><editor:EditorToolContent Icon="chevron-down" Foreground="White"/></StackPanel>
        </Button>
        <Button Content="{Binding Strings[ProjectCaptureSettings]}" Click="OnCaptureSettings" IsEnabled="{Binding CanReturnToRecording}"/>
      </StackPanel>
    </Grid>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding CanCancelExport}" Background="{DynamicResource ProjectCardBrush}" Padding="16,4" BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressBar Width="100" Minimum="0" Maximum="100" Value="{Binding ExportProgress}" IsVisible="{Binding IsExporting}"/>
          <Button Content="{Binding Strings[ProjectExportCancel]}" Command="{Binding CancelExportCommand}" IsVisible="{Binding CanCancelExport}"/>
          <TextBlock Text="{Binding ModeText}" VerticalAlignment="Center" Foreground="{DynamicResource ProjectAccentBrush}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnDefinitions="220,*,260" MinHeight="160">
      <Border x:Name="ClipPane" Background="{DynamicResource ProjectCardBrush}" Padding="12,16" BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="8" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Strings[ProjectClipsShort]}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding State.ClipCount}" FontSize="12" Foreground="{DynamicResource ProjectMutedBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <Button x:Name="ClipDensityToggle" Grid.Column="1" Classes="tool" MinHeight="28" Padding="6,3" Click="OnToggleClipDensity" ToolTip.Tip="{Binding #ClipDensityLabel.Text}" AutomationProperties.Name="{Binding #ClipDensityLabel.Text}">
                <editor:EditorToolContent x:Name="ClipDensityLabel" Icon="{Binding ClipListToggleIcon}">
                  <editor:EditorToolContent.Text>
                    <MultiBinding Converter="{StaticResource ClipDensityLabel}">
                      <Binding Path="IsClipListCompact"/><Binding Path="Strings[ProjectListCompact]"/><Binding Path="Strings[ProjectListThumbnails]"/>
                    </MultiBinding>
                  </editor:EditorToolContent.Text>
                </editor:EditorToolContent>
              </Button>
            </Grid>
            <TextBlock Text="{Binding Strings[ProjectListOrderHint]}" FontSize="11" Foreground="{DynamicResource ProjectMutedBrush}"/>
          </StackPanel>
          <Grid Grid.Row="1" ClipToBounds="True">
          <ListBox x:Name="ClipList" ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}" IsEnabled="{Binding !HasPropertyDraft}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:ProjectClip">
                <editor:ProjectClipCard HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Name}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border x:Name="ClipDropMarker" Height="3" VerticalAlignment="Top" Background="{DynamicResource ProjectAccentBrush}"
                  CornerRadius="2" IsVisible="False" IsHitTestVisible="False"/>
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="{Binding ClipCountText}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="PreviewPane" Grid.Column="1" Padding="20,12" Background="{DynamicResource ProjectCanvasBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Strings[ProjectPreview]}" FontSize="12" Foreground="{DynamicResource ProjectMutedBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding PreviewResolutionText}" FontSize="11" Foreground="{DynamicResource ProjectMutedBrush}"/>
          </Grid>
          <Border Grid.Row="1" Margin="0,8" Background="#11161F" CornerRadius="8" ClipToBounds="True">
            <Grid>
            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </ScrollViewer>
            <Border IsVisible="{Binding HasPreviewSubtitle}" Background="{Binding PreviewSubtitleBackground}"
                    VerticalAlignment="{Binding PreviewSubtitleAlignment}" HorizontalAlignment="Center"
                    Margin="18,20" Padding="10,5" CornerRadius="5" IsHitTestVisible="False" MaxWidth="1000">
              <TextBlock x:Name="PreviewSubtitleText" Text="{Binding PreviewSubtitleText}" FontSize="{Binding PreviewSubtitleFontSize}"
                         Foreground="{Binding PreviewSubtitleForeground}" TextAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="3" OffsetX="1" OffsetY="1"/></TextBlock.Effect>
              </TextBlock>
            </Border>
            </Grid>
          </Border>
          <StackPanel x:Name="PreviewControls" Grid.Row="2" Spacing="3" Margin="0,0">
            <Slider x:Name="FullscreenSeek" IsVisible="False" Minimum="0" Maximum="{Binding DurationTicks}"
                    IsEnabled="{Binding CanPreview}" ValueChanged="OnFullscreenSeekChanged"
                    AutomationProperties.Name="{Binding Strings[ProjectPreviewPlay]}"/>
            <Border Background="{DynamicResource ProjectCardBrush}" BorderBrush="{DynamicResource ProjectStrokeBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="6,4">
            <WrapPanel Orientation="Horizontal">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,10,2">
                <Button Classes="previewControl" Content="{Binding PlaybackButtonText}" Command="{Binding TogglePlaybackCommand}" IsEnabled="{Binding CanPreview}"/>
                <TextBlock Text="{Binding TimelineTimeText}" FontSize="11" FontFamily="monospace" VerticalAlignment="Center"/>
              </StackPanel>
              <ComboBox Classes="previewControl" x:Name="PreviewQualityPicker" SelectedIndex="1" SelectionChanged="OnPreviewQualityChanged" MinWidth="82" Margin="0,2,5,2"
                        IsEnabled="{Binding CanChangePreviewOptions}" ToolTip.Tip="{Binding Strings[PreviewQuality]}" AutomationProperties.Name="{Binding Strings[PreviewQuality]}">
                <ComboBoxItem Content="360p"/><ComboBoxItem Content="720p"/><ComboBoxItem Content="1080p"/>
                <ComboBoxItem Content="{Binding Strings[PreviewOriginal]}" IsEnabled="{Binding CanUseOriginalPreview}" ToolTip.Tip="{Binding Strings[PreviewOriginalHint]}"/>
              </ComboBox>
              <ComboBox Classes="previewControl" x:Name="PreviewZoomPicker" SelectedIndex="0" SelectionChanged="OnPreviewZoomChanged" MinWidth="100" Margin="0,2,5,2"
                        ToolTip.Tip="{Binding Strings[PreviewZoom]}" AutomationProperties.Name="{Binding Strings[PreviewZoom]}">
                <ComboBoxItem Content="{Binding Strings[PreviewFit]}"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/>
              </ComboBox>
              <Button Classes="previewControl" x:Name="PreviewSoundButton" Command="{Binding TogglePreviewSoundCommand}" IsEnabled="{Binding CanChangePreviewOptions}"
                      Margin="0,2,5,2" ToolTip.Tip="{Binding PreviewSoundText}" AutomationProperties.Name="{Binding PreviewSoundText}">
                <editor:EditorToolContent Icon="{Binding PreviewSoundIcon}"/>
              </Button>
              <Button Classes="previewControl" x:Name="PreviewFullscreenButton" Click="OnPreviewFullscreen" Margin="0,2,5,2"
                      ToolTip.Tip="{Binding Strings[PreviewFullscreen]}" AutomationProperties.Name="{Binding Strings[PreviewFullscreen]}">
                <editor:EditorToolContent Icon="fullscreen"/>
              </Button>
              <Button Classes="previewControl" IsEnabled="{Binding HasSubtitleTracks}" Margin="0,2,0,2"
                      ToolTip.Tip="{Binding Strings[SubtitleAttach]}" AutomationProperties.Name="{Binding Strings[SubtitleAttach]}">
                <editor:EditorToolContent Icon="subtitles"/>
                <Button.Flyout><Flyout>
                  <StackPanel Width="280" Spacing="10">
                    <TextBlock Text="{Binding Strings[SubtitleAttach]}" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PreviewSubtitlesPicker" ItemsSource="{Binding PreviewSubtitleOptions}"
                              SelectedItem="{Binding SelectedPreviewSubtitleChoice, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Strings[SubtitleAttach]}"/>
                    <Separator/>
                    <TextBlock Text="{Binding Strings[SubtitleAppearance]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Strings[SubtitleSize]}"/>
                    <Slider Minimum="75" Maximum="200" TickFrequency="25" IsSnapToTickEnabled="True" Value="{Binding PreviewSubtitleScale}"/>
                    <ComboBox SelectedIndex="{Binding PreviewSubtitleTheme, Mode=TwoWay}">
                      <ComboBoxItem Content="{Binding Strings[SubtitleWhiteBlack]}"/><ComboBoxItem Content="{Binding Strings[SubtitleYellowBlack]}"/>
                      <ComboBoxItem Content="{Binding Strings[SubtitleBlackWhite]}"/><ComboBoxItem Content="{Binding Strings[SubtitleWhiteShadow]}"/>
                    </ComboBox>
                    <TextBlock Text="{Binding Strings[SubtitleOpacity]}"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding PreviewSubtitleOpacity}"/>
                    <ComboBox SelectedIndex="{Binding PreviewSubtitlePosition, Mode=TwoWay}">
                      <ComboBoxItem Content="{Binding Strings[SubtitleTop]}"/><ComboBoxItem Content="{Binding Strings[SubtitleMiddle]}"/>
                      <ComboBoxItem Content="{Binding Strings[SubtitleBottom]}"/>
                    </ComboBox>
                    <Button Content="{Binding Strings[SubtitleReset]}" Click="OnResetSubtitleAppearance"/>
                  </StackPanel>
                </Flyout></Button.Flyout>
              </Button>
            </WrapPanel>
            </Border>
            <TextBlock Text="{Binding PreviewStatus}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ProjectMutedBrush}"/>
            <TextBlock Text="{Binding SubtitleSyncWarning}" IsVisible="{Binding State.SubtitlesNeedSyncConfirmation}"
                       FontSize="11" Foreground="#B45309" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="InspectorPane" Grid.Column="2" Background="{DynamicResource ProjectCardBrush}" Padding="16" BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="0,0,16,0">
          <TextBlock Text="{Binding Strings[ProjectProperties]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="{Binding Strings[ProjectClipName]}" FontWeight="SemiBold"/>
          <TextBox Text="{Binding ClipName}" IsEnabled="{Binding CanEditSelection}" MaxLength="200"/>
          <StackPanel Spacing="8" IsEnabled="{Binding CanEditSelection}">
            <TextBlock Text="{Binding Strings[ProjectAudioProperties]}" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Strings[ProjectVolume]}" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding ClipVolumePercent, StringFormat={}{0:0}%}" FontSize="12"/>
            </Grid>
            <Slider x:Name="ClipVolumeSlider" Minimum="0" Maximum="200" Value="{Binding ClipVolumePercent}" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <CheckBox Content="{Binding Strings[ProjectMute]}" IsChecked="{Binding ClipMuted}" MinHeight="28"/>
            <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="{Binding Strings[ProjectFadeIn]}" FontSize="12" Margin="0,0,0,4"/>
              <TextBlock Grid.Column="2" Text="{Binding Strings[ProjectFadeOut]}" FontSize="12" Margin="0,0,0,4"/>
              <NumericUpDown Grid.Row="1" x:Name="ClipFadeInInput" Value="{Binding ClipFadeInSeconds}" Minimum="0" Increment="0.1" FormatString="0.###" ShowButtonSpinner="False"/>
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding ClipFadeOutSeconds}" Minimum="0" Increment="0.1" FormatString="0.###" ShowButtonSpinner="False"/>
            </Grid>
            <Expander Header="{Binding Strings[ProjectVideoProperties]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Strings[ProjectScale]}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding ClipScalePercent, StringFormat={}{0:0}%}" FontSize="12"/></Grid>
                <Slider Minimum="100" Maximum="200" Value="{Binding ClipScalePercent}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Strings[ProjectCrop]}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding ClipCropPercent, StringFormat={}{0:0}%}" FontSize="12"/></Grid>
                <Slider Minimum="0" Maximum="40" Value="{Binding ClipCropPercent}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Strings[ProjectPositionX]}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding ClipPositionX, StringFormat={}{0:0}}" FontSize="12"/></Grid>
                <Slider Minimum="-50" Maximum="50" Value="{Binding ClipPositionX}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Strings[ProjectPositionY]}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding ClipPositionY, StringFormat={}{0:0}}" FontSize="12"/></Grid>
                <Slider Minimum="-50" Maximum="50" Value="{Binding ClipPositionY}" TickFrequency="1" IsSnapToTickEnabled="True"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="{Binding Strings[ProjectPropertyDraft]}" IsVisible="{Binding HasPropertyDraft}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ProjectAccentBrush}"/>
            <TextBlock Text="{Binding Strings[ProjectMixedParts]}" IsVisible="{Binding HasMixedProperties}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ProjectAccentBrush}"/>
            <Button x:Name="ApplyPropertiesButton" Classes="inspectorAction" Command="{Binding ApplyPropertiesCommand}" IsEnabled="{Binding HasPropertyDraft}" Background="#2563EB" Foreground="White">
              <editor:EditorToolContent Icon="check" Text="{Binding Strings[ProjectApplyProperties]}" Foreground="White"/>
            </Button>
            <Button Classes="inspectorAction tool" Command="{Binding ResetPropertiesCommand}" IsEnabled="{Binding HasPropertyDraft}">
              <editor:EditorToolContent Icon="undo" Text="{Binding Strings[ProjectResetProperties]}"/>
            </Button>
          </StackPanel>
          <Separator Margin="0,6"/>
          <Border Background="{DynamicResource ProjectRowBrush}" CornerRadius="10" Padding="10">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Strings[ProjectClips]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ProjectMutedBrush}" Margin="2,0,0,2"/>
              <Grid ColumnDefinitions="*,8,*">
                <Button Classes="inspectorAction" Command="{Binding MoveSelectedEarlierCommand}" IsEnabled="{Binding CanMoveEarlier}"><editor:EditorToolContent Icon="move-up" Text="{Binding Strings[ProjectMoveEarlier]}"/></Button>
                <Button Grid.Column="2" Classes="inspectorAction" Command="{Binding MoveSelectedLaterCommand}" IsEnabled="{Binding CanMoveLater}"><editor:EditorToolContent Icon="move-down" Text="{Binding Strings[ProjectMoveLater]}"/></Button>
              </Grid>
              <Button Classes="inspectorAction" Command="{Binding MergeWithPreviousCommand}" IsEnabled="{Binding CanMergePrevious}"><editor:EditorToolContent Icon="merge-up" Text="{Binding Strings[ProjectMergePrevious]}"/></Button>
              <Button Classes="inspectorAction" Command="{Binding MergeWithNextCommand}" IsEnabled="{Binding CanMergeNext}"><editor:EditorToolContent Icon="merge-down" Text="{Binding Strings[ProjectMergeNext]}"/></Button>
              <Separator Margin="2,4"/>
              <Button Classes="inspectorAction" Command="{Binding GroupWithNextCommand}" IsEnabled="{Binding CanMoveLater}"><editor:EditorToolContent Icon="group" Text="{Binding Strings[ProjectGroupNext]}"/></Button>
              <Button Classes="inspectorAction" Command="{Binding UngroupSelectedCommand}" IsEnabled="{Binding CanUngroup}"><editor:EditorToolContent Icon="ungroup" Text="{Binding Strings[ProjectUngroup]}"/></Button>
            </StackPanel>
          </Border>
          <Button Classes="inspectorAction danger" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanEditTimeline}"><editor:EditorToolContent Icon="delete" Text="{Binding Strings[ProjectDeleteClip]}" Foreground="{DynamicResource ProjectErrorBrush}"/></Button>
          <Border BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="0,1,0,0" Padding="2,12,2,0" Margin="0,4,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Strings[ProjectSourceSafe]}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ProjectMutedBrush}" LineHeight="19"/>
              <Button Classes="inspectorAction tool" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanReplaceProject}"><editor:EditorToolContent Icon="refresh" Text="{Binding Strings[ProjectRefresh]}"/></Button>
            </StackPanel>
          </Border>
          <Button Content="{Binding Strings[ProjectRestoreBackup]}" Click="OnRestoreBackup" IsVisible="{Binding State.NeedsRecoveryConfirmation}"/>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <GridSplitter x:Name="PreviewSplitter" Grid.Row="3" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch"
                  Background="{DynamicResource ProjectStrokeBrush}" ToolTip.Tip="{Binding Strings[PreviewResize]}"/>
    <Border x:Name="TimelinePane" Grid.Row="4" MinHeight="120" Background="{DynamicResource ProjectCardBrush}" BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,8">
      <Border.Styles>
        <Style Selector="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="1,2"/></Style>
        <Style Selector="Border.toolDivider"><Setter Property="Width" Value="1"/><Setter Property="Height" Value="18"/><Setter Property="Margin" Value="7,8"/><Setter Property="Background" Value="{DynamicResource ProjectStrokeBrush}"/></Style>
      </Border.Styles>
      <Grid RowDefinitions="Auto,*">
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="ClipsToggle" Click="OnToggleClips" AutomationProperties.Name="{Binding Strings[ProjectClipsShort]}"><editor:EditorToolContent Icon="clips" Text="{Binding Strings[ProjectClipsShort]}"/></Button>
          <Button x:Name="PropertiesToggle" Click="OnToggleProperties" AutomationProperties.Name="{Binding Strings[ProjectPropertiesShort]}"><editor:EditorToolContent Icon="properties" Text="{Binding Strings[ProjectPropertiesShort]}"/></Button>
          <Border Classes="toolDivider"/>
          <Button Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" AutomationProperties.Name="{Binding Strings[ProjectUndo]}"><editor:EditorToolContent Icon="undo" Text="{Binding Strings[ProjectUndo]}"/></Button>
          <Button Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" AutomationProperties.Name="{Binding Strings[ProjectRedo]}"><editor:EditorToolContent Icon="redo" Text="{Binding Strings[ProjectRedo]}"/></Button>
          <Border Classes="toolDivider"/>
          <Button Command="{Binding SplitAtPlayheadCommand}" IsEnabled="{Binding CanSplit}" AutomationProperties.Name="{Binding Strings[ProjectSplit]}"><editor:EditorToolContent Icon="split" Text="{Binding Strings[ProjectSplit]}"/></Button>
          <Button Command="{Binding MarkRangeStartCommand}" IsEnabled="{Binding CanEditTimeline}" AutomationProperties.Name="{Binding Strings[ProjectRangeStart]}"><editor:EditorToolContent Icon="start" Text="{Binding Strings[ProjectRangeStart]}"/></Button>
          <Button Command="{Binding MarkRangeEndCommand}" IsEnabled="{Binding CanEditTimeline}" AutomationProperties.Name="{Binding Strings[ProjectRangeEnd]}"><editor:EditorToolContent Icon="end" Text="{Binding Strings[ProjectRangeEnd]}"/></Button>
          <Button Command="{Binding DeleteRangeCommand}" IsEnabled="{Binding CanDeleteRange}" AutomationProperties.Name="{Binding Strings[ProjectDeleteRange]}"><editor:EditorToolContent Icon="delete" Text="{Binding Strings[ProjectDeleteRange]}"/></Button>
          <Border Classes="toolDivider"/>
          <Button Click="OnFitTimeline" AutomationProperties.Name="{Binding Strings[ProjectFitTimeline]}"><editor:EditorToolContent Icon="fit" Text="{Binding Strings[ProjectFitTimeline]}"/></Button>
        </WrapPanel>
        <editor:ProjectTimelineControl x:Name="TimelineControl" Grid.Row="1" ToolTip.Tip="{Binding Strings[ProjectTimelineHelp]}"/>
      </Grid>
    </Border>
    <Grid x:Name="EditorFooter" Grid.Row="5" ColumnDefinitions="*,Auto" Margin="16,4">
      <TextBlock Text="{Binding ExportStatusText}" IsVisible="{Binding !HasEditorError}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExportStatusText}"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ProjectErrorBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Error}"/>
    </Grid>
  </Grid>
</Window>
