<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:ScreenRecorder.UI.Projects" xmlns:core="using:ScreenRecorder.Core.Projects"
        x:Class="ScreenRecorder.UI.Projects.ProjectWorkspaceView" x:DataType="p:ProjectWorkspaceViewModel"
        Title="{Binding Strings[ProjectWorkspace]}" Icon="/Assets/app_icon.png"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640" Background="{DynamicResource ProjectCanvasBrush}"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ProjectCanvasBrush" Color="#F4F6F8"/>
          <SolidColorBrush x:Key="ProjectCardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ProjectRowBrush" Color="#F1F5F9"/>
          <SolidColorBrush x:Key="ProjectTextBrush" Color="#0F172A"/>
          <SolidColorBrush x:Key="ProjectMutedBrush" Color="#64748B"/>
          <SolidColorBrush x:Key="ProjectStrokeBrush" Color="#E2E8F0"/>
          <SolidColorBrush x:Key="ProjectAccentBrush" Color="#2563EB"/>
          <SolidColorBrush x:Key="ProjectErrorBrush" Color="#B42318"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ProjectCanvasBrush" Color="#202329"/>
          <SolidColorBrush x:Key="ProjectCardBrush" Color="#292D34"/>
          <SolidColorBrush x:Key="ProjectRowBrush" Color="#323842"/>
          <SolidColorBrush x:Key="ProjectTextBrush" Color="#F1F5F9"/>
          <SolidColorBrush x:Key="ProjectMutedBrush" Color="#A8B5C7"/>
          <SolidColorBrush x:Key="ProjectStrokeBrush" Color="#455060"/>
          <SolidColorBrush x:Key="ProjectAccentBrush" Color="#86B4FF"/>
          <SolidColorBrush x:Key="ProjectErrorBrush" Color="#FFAEA6"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ProjectTextBrush}"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,240,Auto" Margin="16">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="5">
        <TextBlock Text="{Binding Strings[ProjectWorkspace]}" FontSize="12" Foreground="{DynamicResource ProjectMutedBrush}"/>
        <TextBlock Text="{Binding State.Name}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding State.Name}" Margin="0,0,12,0" Foreground="{DynamicResource ProjectTextBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="{Binding Strings[ProjectNew]}" Click="OnNew" IsEnabled="{Binding !IsBusy}"/>
        <Button Content="{Binding Strings[ProjectOpen]}" Click="OnOpen" IsEnabled="{Binding !IsBusy}"/>
        <Button Content="{Binding Strings[ProjectSave]}" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button Content="{Binding Strings[ProjectClose]}" Click="OnClose"/>
      </StackPanel>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding State.Directory}" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource ProjectMutedBrush}" FontSize="12" Margin="0,8,0,0"/>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource ProjectCardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{Binding StartText}" Click="OnRecord" IsEnabled="{Binding CanRecord}" Background="#2563EB" Foreground="White"/>
          <Button Content="{Binding Strings[ProjectPause]}" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}"/>
          <Button Content="{Binding Strings[ProjectFinish]}" Command="{Binding FinishCommand}" IsEnabled="{Binding CanFinish}"/>
          <Button Content="{Binding Strings[ProjectCaptureSettings]}" Click="OnCaptureSettings"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ModeText}" VerticalAlignment="Center" Foreground="{DynamicResource ProjectAccentBrush}"/>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnDefinitions="220,*,260">
      <Border x:Name="ClipPane" Background="{DynamicResource ProjectCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,0" BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*" Margin="0,0,0,12">
            <TextBlock Text="{Binding Strings[ProjectClips]}" FontSize="14" FontWeight="SemiBold"/>

          </Grid>
          <ListBox x:Name="ClipList" Grid.Row="1" ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:ProjectClip">
                <Border Padding="12,14" Margin="0,3" CornerRadius="8" Background="{DynamicResource ProjectRowBrush}" HorizontalAlignment="Stretch">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Name}" FontSize="14" Foreground="{DynamicResource ProjectTextBrush}"/>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="{Binding ClipCountText}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="PreviewPane" Grid.Column="1" Padding="20,16" Background="{DynamicResource ProjectCanvasBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="{Binding Strings[ProjectPreview]}" FontSize="12" Foreground="{DynamicResource ProjectMutedBrush}"/>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Spacing="12">
            <TextBlock Text="{Binding Strings[ProjectWorkspace]}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Text="{Binding Strings[ProjectPreviewPending]}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource ProjectMutedBrush}"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="{Binding ModeText}" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource ProjectAccentBrush}"/>
        </Grid>
      </Border>
      <Border x:Name="InspectorPane" Grid.Column="2" Background="{DynamicResource ProjectCardBrush}" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource ProjectStrokeBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,20,0">
          <TextBlock Text="{Binding Strings[ProjectClipName]}" FontWeight="SemiBold"/>
          <TextBox Text="{Binding ClipName}" IsEnabled="{Binding CanEdit}" MaxLength="200"/>
          <Button Content="{Binding Strings[ProjectRename]}" Command="{Binding RenameSelectedCommand}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Grid ColumnDefinitions="*,8,*">
            <Button Content="{Binding Strings[ProjectMoveEarlier]}" Command="{Binding MoveSelectedEarlierCommand}" IsEnabled="{Binding CanMoveEarlier}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="{Binding Strings[ProjectMoveLater]}" Command="{Binding MoveSelectedLaterCommand}" IsEnabled="{Binding CanMoveLater}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </Grid>
          <Button Content="{Binding Strings[ProjectDeleteClip]}" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanEditSelection}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Separator Margin="0,8"/>
          <TextBlock Text="{Binding Strings[ProjectSourceSafe]}" TextWrapping="Wrap" Foreground="{DynamicResource ProjectAccentBrush}" LineHeight="22"/>

          <Button Content="{Binding Strings[ProjectRefresh]}" Command="{Binding RefreshCommand}"/>
          <Button Content="{Binding Strings[ProjectRestoreBackup]}" Click="OnRestoreBackup" IsVisible="{Binding State.NeedsRecoveryConfirmation}"/>
          <TextBlock Text="{Binding Strings[ProjectRecent]}" FontWeight="SemiBold" Margin="0,10,0,0"/>
          <ComboBox x:Name="RecentProjects" HorizontalAlignment="Stretch" MaxWidth="198"/>
          <Button Content="{Binding Strings[ProjectOpen]}" Click="OnOpenRecent"/>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border x:Name="TimelinePane" Grid.Row="3" Background="{DynamicResource ProjectCardBrush}" CornerRadius="8" Margin="0,8,0,0" Padding="12">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ClipsToggle" Content="{Binding Strings[ProjectClips]}" Click="OnToggleClips"/>
          <Button x:Name="PropertiesToggle" Content="{Binding Strings[ProjectProperties]}" Click="OnToggleProperties"/>
          <Button Content="{Binding Strings[ProjectUndo]}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
          <Button Content="{Binding Strings[ProjectRedo]}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
          <TextBlock Text="{Binding Strings[ProjectTimeline]}" VerticalAlignment="Center" Margin="12,0"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding Strings[ProjectTimelinePending]}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource ProjectMutedBrush}" TextWrapping="Wrap" MaxWidth="640"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="4" Spacing="5" Margin="0,16,0,0">
      <TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource ProjectAccentBrush}"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ProjectErrorBrush}" TextWrapping="Wrap" MaxHeight="70"/>
    </StackPanel>
  </Grid>
</Window>
