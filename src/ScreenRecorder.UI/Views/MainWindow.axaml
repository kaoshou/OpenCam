<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScreenRecorder.UI.ViewModels"
        x:Class="ScreenRecorder.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Strings[AppTitle]}"
        Icon="/Assets/app_icon.png"
        Width="840" Height="720"
        MinWidth="820" MinHeight="580"
        Background="#F8FAFC"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,14">
        <!-- 頂部控制工具列卡片 (現代曜石白微光卡片) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" 
                Padding="12,10" Margin="0,0,0,12" BoxShadow="0 4 16 #0F172A08">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                    <!-- 開始錄影按鈕 (奢華翡翠綠立體微光漸層) -->
                    <Button Command="{Binding StartRecordingCommand}"
                            IsEnabled="{Binding CanStartRecording}"
                            Foreground="White" FontWeight="Bold" FontSize="12.5" 
                            Padding="14,7.5" CornerRadius="8"
                            ToolTip.Tip="{Binding StartRecordingTooltipText}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#059669" Offset="0.0"/>
                                <GradientStop Color="#10B981" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#FFFFFF"
                                    BoxShadow="0 0 6 #FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Strings[StartRecording]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 暫停 / 繼續按鈕 (優雅琥珀金/靈動翡翠綠切換) -->
                    <Button Command="{Binding TogglePauseResumeCommand}"
                            IsEnabled="{Binding CanPauseOrResume}"
                            Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Foreground="#92400E"
                            FontWeight="SemiBold" FontSize="12" Padding="12,7.5" CornerRadius="8"
                            ToolTip.Tip="{Binding PauseResumeTooltipText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- 錄影中顯示暫停圖示 (雙豎線) -->
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#B45309" VerticalAlignment="Center"
                                  IsVisible="{Binding !IsPaused}"
                                  Data="M6 4h3v16H6V4zm9 0h3v16h-3V4z" />
                            <!-- 暫停中顯示繼續圖示 (三角播放) -->
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#059669" VerticalAlignment="Center"
                                  IsVisible="{Binding IsPaused}"
                                  Data="M8 5v14l11-7z" />
                            <TextBlock Text="{Binding PauseResumeButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 停止錄影按鈕 (典雅深紅寶石漸層微光) -->
                    <Button Command="{Binding StopRecordingCommand}"
                            IsEnabled="{Binding CanStopRecording}"
                            Foreground="White" FontWeight="Bold" FontSize="12.5" 
                            Padding="14,7.5" CornerRadius="8"
                            ToolTip.Tip="{Binding StopRecordingTooltipText}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#DC2626" Offset="0.0"/>
                                <GradientStop Color="#EF4444" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="2" Background="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Strings[StopRecording]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>



                    <!-- 修復救援按鈕 (柔和琥珀金) -->
                    <Button Command="{Binding RecoverSessionsCommand}"
                            Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Foreground="#92400E"
                            FontWeight="SemiBold" FontSize="11.5" Padding="11,7.5" CornerRadius="8"
                            ToolTip.Tip="{Binding Strings[TooltipRecovery]}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="#B45309" VerticalAlignment="Center"
                                  Data="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                            <TextBlock Text="{Binding Strings[Recovery]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 右上角：偏好設定按鈕 (語言已收納至設定內，關於已收納至設定內) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <!-- 偏好設定按鈕 (簡潔高雅微光齒輪) -->
                    <Button Click="OnSettingsClicked"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            Foreground="#334155" FontSize="11.5" Padding="10,6.5" CornerRadius="7"
                            VerticalAlignment="Center" Cursor="Hand"
                            ToolTip.Tip="{Binding Strings[TooltipSettings]}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="#64748B" VerticalAlignment="Center"
                                  Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                            <TextBlock Text="{Binding Strings[Settings]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 醒目初始化提示條 (琥珀金橫幅，僅在管線啟動期間淡入) -->
        <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" 
                Padding="14,8" Margin="0,0,0,12" IsVisible="{Binding IsPreparing}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"
                      Data="M6 2v6h.01L6 8.01 10 12l-4 4 .01.01H6V22h12v-5.99h-.01L18 16l-4-4 4-3.99-.01-.01H18V2H6zm10 14.5V20H8v-3.5l4-4 4 4zM12 11.5l-4-4V4h8v3.5l-4 4z" />
                <TextBlock Grid.Column="1" Text="{Binding Strings[PreparingBanner]}" 
                           Foreground="#B45309" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#FDE68A" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding Strings[StartingBadge]}" Foreground="#78350F" FontWeight="Bold" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <!-- 中間設定與狀態監控雙面板 -->
        <Grid Grid.Row="2" ColumnDefinitions="1.25*,*" Margin="0,0,0,12">
            <!-- 左側：錄影配置卡片 (純白俐落、智慧卷軸適應) -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" 
                    Padding="14,12" Margin="0,0,8,0" BoxShadow="0 4 16 #0F172A08">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              IsEnabled="{Binding CanEditRecordingSettings}">
                    <StackPanel Spacing="9" Margin="0,0,6,0">
                    <!-- 錄影目標即時提示徽章 (冰藍漸層微光標籤) -->
                    <Border BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#F0F7FF" Offset="0.0"/>
                                <GradientStop Color="#E0EFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Width="13" Height="13" Stretch="Uniform" Fill="#1D4ED8" VerticalAlignment="Center"
                                  Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm0-14a6 6 0 1 0 6 6 6 6 0 0 0-6-6zm0 10a4 4 0 1 1 4-4 4 4 0 0 1-4 4z" />
                            <TextBlock Text="{Binding CurrentTargetSummary}" Foreground="#1E40AF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 分組 1：錄影範圍 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Strings[RangeTitle]}" FontWeight="Bold" FontSize="12" Foreground="#1E293B" />
                        

                        <!-- 指定螢幕 -->
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <RadioButton Grid.Column="0" GroupName="Range" IsChecked="{Binding IsMonitorSelected}" 
                                         IsEnabled="{Binding !IsRecording}" Content="{Binding Strings[RangeMonitor]}" VerticalAlignment="Center" FontSize="12" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableMonitors}" SelectedItem="{Binding SelectedMonitor}" 
                                      IsEnabled="{Binding CanSelectMonitor}" Margin="8,0,0,0" HorizontalAlignment="Stretch" FontSize="11.5" />
                        </Grid>

                        <!-- 自訂區域 -->
                        <RadioButton GroupName="Range" IsChecked="{Binding IsCustomRegion}" 
                                     IsEnabled="{Binding !IsRecording}" Content="{Binding Strings[RangeCustomRegion]}" FontSize="12" />

                        <!-- 自訂區域之內嵌調整面板 (展開時呈現精緻淺灰卡片) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" 
                                Padding="10,6" Margin="22,2,0,2" IsVisible="{Binding IsCustomRegion}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding CustomRegionDisplayText}"
                                           Foreground="#0369A1" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="OnSelectRegionClicked"
                                        IsEnabled="{Binding CanConfigureCustomRegion}"
                                        Background="#0284C7" Foreground="White"
                                        FontSize="11" Padding="10,5" CornerRadius="6"
                                        ToolTip.Tip="{Binding Strings[TooltipAdjustRegion]}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Width="11" Height="11" Stretch="Uniform" Fill="#FFFFFF" VerticalAlignment="Center"
                                              Data="M5 3a2 2 0 0 0-2 2v2h2V5h2V3H5zm14 0h-2v2h2v2h2V5a2 2 0 0 0-2-2zM3 17v2a2 2 0 0 0 2 2h2v-2H5v-2H3zm16 2v-2h2v2a2 2 0 0 0-2 2h-2v-2h2zM9 9h6v6H9z" />
                                        <TextBlock Text="{Binding Strings[AdjustRegion]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 分隔灰線 -->
                    <Rectangle Height="1" Fill="#F1F5F9" HorizontalAlignment="Stretch" />

                    <!-- 分組 2：FPS 幀率與視訊編碼器與游標樣式 -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                        <TextBlock Text="{Binding Strings[FpsTitle]}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}" 
                                  IsEnabled="{Binding !IsRecording}" HorizontalAlignment="Stretch" FontSize="11.5" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <TextBlock Text="{Binding Strings[EncoderTitle]}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableEncoders}" SelectedItem="{Binding SelectedEncoder}" 
                                  IsEnabled="{Binding !IsRecording}" HorizontalAlignment="Stretch" FontSize="11.5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11.5" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <TextBlock Text="{Binding Strings[CursorTitle]}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCursorEffects}" SelectedItem="{Binding SelectedCursorEffect}" 
                                  IsEnabled="{Binding !IsRecording}" HorizontalAlignment="Stretch" FontSize="11.5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11.5" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- 分隔灰線 -->
                    <Rectangle Height="1" Fill="#F1F5F9" HorizontalAlignment="Stretch" />

                    <!-- 分組 3：音訊設定 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Strings[AudioTitle]}" FontWeight="Bold" FontSize="12" Foreground="#1E293B" />

                        <CheckBox IsChecked="{Binding RecordSystemAudio}" IsEnabled="{Binding CanRecordSystemAudio}"
                                  Content="{Binding SystemAudioLabel}" FontSize="12" />
                        
                        <CheckBox IsChecked="{Binding RecordMicrophone}" IsEnabled="{Binding !IsRecording}" 
                                  Content="{Binding Strings[AudioMic]}" FontSize="12" />
                        
                        <!-- 麥克風設備選擇列 (展開時附精準邊距) -->
                        <Grid ColumnDefinitions="Auto,*" Margin="22,2,0,4" IsVisible="{Binding RecordMicrophone}">
                            <TextBlock Text="{Binding Strings[MicDevice]}" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableMicrophones}" SelectedItem="{Binding SelectedMicrophone}" 
                                      IsEnabled="{Binding CanSelectMicrophone}" HorizontalAlignment="Stretch" FontSize="11" />
                        </Grid>
                    </StackPanel>

                    <!-- 分隔灰線 -->
                    <Rectangle Height="1" Fill="#F1F5F9" HorizontalAlignment="Stretch" />

                    <!-- 分組 4：儲存位置設定 -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding Strings[StorageTitle]}" FontWeight="Bold" FontSize="12" Foreground="#1E293B" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" IsReadOnly="True" 
                                     Background="#F8FAFC" BorderBrush="#E2E8F0" CornerRadius="6"
                                     FontSize="11" VerticalAlignment="Center" ToolTip.Tip="{Binding OutputDirectory}" />
                            
                            <!-- 開啟資料夾 -->
                            <Button Grid.Column="1" Command="{Binding OpenOutputFolderCommand}"
                                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155"
                                    FontSize="11.5" Padding="11,6" CornerRadius="6" Margin="6,0,0,0"
                                    ToolTip.Tip="{Binding Strings[TooltipFolder]}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Width="12" Height="11" Stretch="Uniform" Fill="#475569" VerticalAlignment="Center"
                                          Data="M19 19H5V5H12V3H5C3.89 3 3 3.9 3 5V19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V12H19V19ZM14 3V5H17.59L7.76 14.83L9.17 16.24L19 6.41V10H21V3H14Z" />
                                    <TextBlock Text="{Binding Strings[OpenFolder]}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 變更資料夾 -->
                            <Button Grid.Column="2" Click="OnChangeOutputFolderClicked"
                                    IsEnabled="{Binding !IsRecording}"
                                    Background="#334155" Foreground="White"
                                    FontSize="11.5" Padding="11,6" CornerRadius="6" Margin="6,0,0,0"
                                    ToolTip.Tip="{Binding Strings[TooltipChangeFolder]}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Width="12" Height="11" Stretch="Uniform" Fill="#FFFFFF" VerticalAlignment="Center"
                                          Data="M2,4 C1.4,4 1,4.4 1,5 L1,15 C1,15.6 1.4,16 2,16 L18,16 C18.6,16 19,15.6 19,15 L19,7 C19,6.4 18.6,6 18,6 L9,6 L7.4,4.4 C7,4.1 6.5,4 6,4 Z" />
                                    <TextBlock Text="{Binding Strings[ChangeFolder]}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 分隔灰線 -->
                    <Rectangle Height="1" Fill="#F1F5F9" HorizontalAlignment="Stretch" />

                    <!-- 偏好設定：錄影時自動最小化 -->
                    <CheckBox IsChecked="{Binding MinimizeOnRecord}" IsEnabled="{Binding !IsRecording}"
                              Content="{Binding Strings[MinimizeOnRecord]}" FontSize="11.5" Foreground="#475569" />
                </StackPanel>
            </ScrollViewer>
        </Border>

            <!-- 右側：高科技曜石黑狀態監控儀表板 (Obsidian Glassmorphism Dashboard) -->
            <Border Grid.Column="1" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" 
                    Padding="16,14" Margin="2,0,0,0" BoxShadow="0 8 30 #02061760">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#090D16" Offset="0.0"/>
                        <GradientStop Color="#0F172A" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 頂部標題與狀態指示點 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Strings[MonitorTitle]}" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        
                        <!-- 狀態膠囊徽章 (待命中 / 錄影中 / 已暫停) -->
                        <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="20" Padding="8,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="7" Height="7" CornerRadius="4" Background="{Binding StatusBadgeColor}" BoxShadow="{Binding StatusBadgeBoxShadow}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusBadgeTextColor}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 中央計時器與數據小卡片 -->
                    <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center" Margin="0,10">
                        <!-- 計時器大字 (數位液晶排版) -->
                        <Border Background="#050811" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,10"
                                HorizontalAlignment="Center" BoxShadow="0 2 10 #00000040">
                            <TextBlock Text="{Binding ElapsedTimeText}" 
                                       Foreground="{Binding TimerForeground}" 
                                       FontSize="38" 
                                       FontWeight="Bold" 
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <!-- 檔案大小與磁碟空間雙方塊卡片 (獨立磨砂黑金屬卡片) -->
                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                            <!-- 檔案大小 -->
                            <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,4,0"
                                    BoxShadow="0 2 8 #00000030">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Strings[FileSizeLabel]}" Foreground="#64748B" FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FileSizeText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                            </Border>

                            <!-- 磁碟剩餘 -->
                            <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="4,0,0,0"
                                    BoxShadow="0 2 8 #00000030">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Strings[DiskRemainingLabel]}" Foreground="#64748B" FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DiskRemainingText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 底部安全工作容器說明標籤 (深邃防護盾徽章) -->
                    <Border Grid.Row="2" Background="#064E3B20" BorderBrush="#065F46" BorderThickness="1" CornerRadius="7" Padding="10,7">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                              <Path Width="14" Height="15" Stretch="Uniform" Fill="#34D399" VerticalAlignment="Center"
                                    Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" />
                              <TextBlock Text="{Binding Strings[SafeContainerNotice]}" 
                                         Foreground="#34D399" FontSize="11.5" TextAlignment="Center" FontWeight="Medium"
                                         VerticalAlignment="Center" />
                          </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部狀態列卡片 (簡潔淡雅曜石白) -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="12,7" BoxShadow="0 1 4 #0F172A06">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#334155" FontSize="11.5" 
                           TextTrimming="CharacterEllipsis" FontWeight="Medium" VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="OnAboutClicked" Background="Transparent" BorderThickness="0" 
                        Padding="4,0" Cursor="Hand" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Strings[VersionAndAbout]}" Foreground="#64748B" FontSize="11" TextDecorations="Underline" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
