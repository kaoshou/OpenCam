<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScreenRecorder.UI.Views.RecordingCloseWarningWindow"
        Title="{Binding [RecordingCloseWarningTitle]}"
        Icon="/Assets/app_icon.png"
        Width="480" Height="270"
        MinWidth="480" MinHeight="270"
        MaxWidth="480" MaxHeight="270"
        Background="#F8FAFC"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="24,22,24,20">
        <StackPanel Grid.Row="0" Spacing="14" VerticalAlignment="Center">
            <Border Width="48" Height="48"
                    HorizontalAlignment="Center"
                    Background="#FEF3C7"
                    CornerRadius="24">
                <TextBlock Text="!"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#D97706"
                           FontSize="28"
                           FontWeight="Bold" />
            </Border>

            <TextBlock Name="WarningMessageText" Text="{Binding [RecordingCloseWarningMessage]}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#0F172A"
                       FontSize="16"
                       FontWeight="Bold" />

            <TextBlock Name="WarningDetailText" Text="{Binding [RecordingCloseWarningDetail]}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#64748B"
                       FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Content="{Binding [ReturnToRecording]}"
                    Click="OnReturnClicked"
                    MinWidth="150"
                    Padding="18,9"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    CornerRadius="7" />
            <Button Name="ForceQuitButton"
                    Content="{Binding [ForceQuitButton]}"
                    Click="OnForceQuitClicked"
                    IsVisible="False"
                    MinWidth="150"
                    Padding="18,9"
                    Background="#FEE2E2"
                    Foreground="#991B1B"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="7" />
        </StackPanel>
    </Grid>
</Window>
