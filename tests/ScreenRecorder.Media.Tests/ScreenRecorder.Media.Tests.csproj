<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.2.5" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenRecorder.TestChild\ScreenRecorder.TestChild.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ScreenRecorder.ProjectRecordingProbe\ScreenRecorder.ProjectRecordingProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\ScreenRecorder.Core\ScreenRecorder.Core.csproj" />
    <ProjectReference Include="..\..\src\ScreenRecorder.Media\ScreenRecorder.Media.csproj" />
    <ProjectReference Include="..\..\src\ScreenRecorder.Platform.macOS\ScreenRecorder.Platform.macOS.csproj" />
    <ProjectReference Include="..\..\src\ScreenRecorder.Platform.Windows\ScreenRecorder.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\ScreenRecorder.Recorder\ScreenRecorder.Recorder.csproj" />
    <ProjectReference Include="..\..\src\ScreenRecorder.UI\ScreenRecorder.UI.csproj" />
  </ItemGroup>

  <Target Name="CopyProbeTestChild" AfterTargets="Build">
    <ItemGroup>
      <ProbeTestChildFiles Include="$(MSBuildThisFileDirectory)../ScreenRecorder.TestChild/bin/$(Configuration)/net8.0/ScreenRecorder.TestChild.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProbeTestChildFiles)" DestinationFolder="$(OutDir)probe-child" />
  </Target>
  <Target Name="CopyProjectRecordingProbe" AfterTargets="Build">
    <ItemGroup><ProjectRecordingProbeFiles Include="$(MSBuildThisFileDirectory)../ScreenRecorder.ProjectRecordingProbe/bin/$(Configuration)/net8.0/*" /></ItemGroup>
    <Copy SourceFiles="@(ProjectRecordingProbeFiles)" DestinationFolder="$(OutDir)project-recording-probe" />
  </Target>
</Project>
